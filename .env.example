NODE_ENV=development
PORT=4000
SESSION_COOKIE_NAME=lead_exchange_session
# Leave DATABASE_URL unset for the persistent embedded PostgreSQL development database.
# For Neon, copy the pooled connection string into the ignored .env file.
# Keep sslmode=require. Never put a real connection string in this example file.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Production must use a dedicated Lead Exchange PostgreSQL database, never Aviat CRM.

# Email verification/recovery and outbound notifications (Resend).
# Configure these in the ignored .env file; no email is sent until all values are valid.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=replace-with-provider-key
# NOTIFICATION_EMAIL_FROM=Lead Exchange <noreply@your-verified-domain.example>
# APP_BASE_URL=https://your-deployed-frontend.example
# EMAIL_TOKEN_ENCRYPTION_KEY=base64-encoded-random-32-byte-key
# MFA_ENCRYPTION_KEY=base64-encoded-different-random-32-byte-key
# Marketplace configuration (optional; defaults shown). Validated at startup with zod.
# DEFAULT_COUNTRY=IN
# DEFAULT_CURRENCY=INR
# MAX_INVITED_SUPPLIERS=20
# REQUEST_DEADLINE_MIN_HOURS=1
# REQUEST_DEADLINE_DEFAULT_HOURS=72
# REQUEST_DEADLINE_MAX_DAYS=90
# OFFER_VALIDITY_DEFAULT_DAYS=5
# OFFER_VALIDITY_MAX_DAYS=90
# INVITATION_TTL_HOURS=168
# MAX_PENDING_INVITATIONS=50
# MAX_OFFER_LINE_ITEMS=50
# REMINDER_DEADLINE_HOURS=24
# REMINDER_OFFER_EXPIRY_HOURS=48
# REMINDER_JOB_INTERVAL_SECONDS=300
# DEADLINE_JOB_INTERVAL_SECONDS=60
# AUTH_RATE_LIMIT_WINDOW_MINUTES=15
# AUTH_RATE_LIMIT_MAX=10
# EMAIL_ACTION_RATE_LIMIT_WINDOW_MINUTES=60
# EMAIL_ACTION_RATE_LIMIT_MAX=5
# MFA_RATE_LIMIT_MAX=10
# INVITATION_RATE_LIMIT_PER_HOUR=30
# REPORT_RATE_LIMIT_PER_HOUR=20
# SESSION_LIFETIME_HOURS=336
# MFA_CHALLENGE_TTL_MINUTES=5
# MAX_COVERAGE_DESTINATIONS=20
# DESTINATION_SEARCH_LIMIT=20
# DESTINATION_SEARCH_RATE_LIMIT_PER_MINUTE=120
# Retention defaults; platform admins can override the first two in admin settings.
# ACCOUNT_DELETION_GRACE_DAYS=30
# UNVERIFIED_ACCOUNT_RETENTION_DAYS=30
# RETENTION_JOB_INTERVAL_SECONDS=3600
# ACCOUNT_EXPORT_RATE_LIMIT_PER_HOUR=5
# Destination master data import (npm run destinations:import -- --country IN).
# GEONAMES_DUMP_URL=https://download.geonames.org/export/dump
# GEONAMES_CITIES_DATASET=cities15000
# Shown on the public privacy policy page (DPDP Act grievance officer). Name and email are both required to show it.
# LEGAL_ENTITY_NAME=Your registered company name
# GRIEVANCE_OFFICER_NAME=Officer name
# GRIEVANCE_OFFICER_EMAIL=grievance@your-domain.example
# GRIEVANCE_OFFICER_PHONE=+91 ...
# GRIEVANCE_OFFICER_ADDRESS=Registered office address

# Verification document storage (private bucket/container only). Leave unset to disable uploads.
# Use an India region for launch: AWS ap-south-1 (Mumbai) or Azure Central India.
# Also configure a lifecycle rule and encryption at rest on the bucket/container itself.
# STORAGE_PROVIDER=s3            # s3 | azure
# STORAGE_KEY_PREFIX=verification-documents
# --- S3 and S3-compatible (AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces, MinIO) ---
# S3_BUCKET=your-private-bucket
# S3_REGION=ap-south-1
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # only for non-AWS providers
# S3_FORCE_PATH_STYLE=false                                 # true for MinIO
# S3_ACCESS_KEY_ID=replace-with-key-id                      # omit both to use the AWS default credential chain / IAM role
# S3_SECRET_ACCESS_KEY=replace-with-secret
# S3_SERVER_SIDE_ENCRYPTION=AES256                          # AES256 | aws:kms (AWS only)
# S3_KMS_KEY_ID=
# --- Azure Blob Storage (signed links need the account key) ---
# AZURE_STORAGE_CONTAINER=verification-documents
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# or AZURE_STORAGE_ACCOUNT_NAME=youraccount and AZURE_STORAGE_ACCOUNT_KEY=replace-with-key
# AZURE_STORAGE_ENDPOINT=                                   # optional, e.g. Azurite http://127.0.0.1:10000/devstoreaccount1

# Malware scanning (ClamAV clamd over TCP or a Unix socket). Uploads stay unreadable until scanned clean.
# MALWARE_SCANNER=clamav
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
# CLAMAV_TIMEOUT_MS=60000

# Document upload limits and jobs (defaults shown).
# DOCUMENT_MAX_MB=10
# DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
# DOCUMENT_MAX_PER_ORGANIZATION=40
# DOCUMENT_UPLOAD_RATE_LIMIT_PER_HOUR=30
# DOCUMENT_DOWNLOAD_URL_TTL_SECONDS=300
# DOCUMENT_SCAN_JOB_INTERVAL_SECONDS=30
# DOCUMENT_SCAN_MAX_ATTEMPTS=8
# Retention defaults; platform admins can override both in admin settings.
# REJECTED_DOCUMENT_RETENTION_DAYS=90
# CLOSED_ORGANIZATION_DOCUMENT_RETENTION_DAYS=365

# Booking confirmation and guest details. Without the key, bookings cannot be confirmed and guest details stay closed.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# GUEST_DATA_ENCRYPTION_KEY=base64-encoded-random-32-byte-key-different-from-the-others
# Retention defaults; platform admins can override both in admin settings.
# GUEST_DATA_SELLER_ACCESS_DAYS=30
# GUEST_DATA_RETENTION_DAYS=90
# GUEST_DETAILS_VIEW_RATE_LIMIT_PER_HOUR=120
# BOOKING_VOUCHER_MAX_PER_BOOKING=5
# BOOKING_VOUCHER_KEY_PREFIX=booking-vouchers

# Signed webhooks (Standard Webhooks). Without the key, endpoints cannot be created and queued events wait unsent.
# WEBHOOK_SECRET_ENCRYPTION_KEY=base64-encoded-random-32-byte-key-different-from-the-others
# WEBHOOK_MAX_ENDPOINTS_PER_ORGANIZATION=5
# WEBHOOK_TIMEOUT_MS=10000
# WEBHOOK_MAX_ATTEMPTS=10
# WEBHOOK_RETRY_BASE_SECONDS=30
# WEBHOOK_RETRY_MAX_MINUTES=720
# WEBHOOK_DISABLE_AFTER_FAILURES=30
# WEBHOOK_SECRET_ROTATION_GRACE_HOURS=24
# WEBHOOK_DELIVERY_RETENTION_DAYS=30
# WEBHOOK_JOB_INTERVAL_SECONDS=5
# WEBHOOK_MANAGE_RATE_LIMIT_PER_HOUR=30
# Local development only: allows http:// and private-network receivers. Refused when NODE_ENV=production.
# WEBHOOK_ALLOW_INSECURE_URLS=false

# Backups and restore drills (npm run db:backup, npm run db:restore-drill). See docs/runbooks/backup-and-restore.md.
# Needs pg_dump/pg_restore of the server's major version or newer.
# BACKUP_DATABASE_URL=postgresql://USER:PASSWORD@DIRECT-NON-POOLED-HOST/DATABASE?sslmode=require
# RESTORE_DRILL_DATABASE_URL=   # set per drill in the shell only; an empty throwaway database
# BACKUP_DIRECTORY=.backups
# BACKUP_KEY_PREFIX=database-backups
# BACKUP_MAX_AGE_HOURS=26
# RESTORE_DRILL_MAX_AGE_DAYS=35
# PG_BIN_DIRECTORY=C:\Program Files\PostgreSQL\17\bin
